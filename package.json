{
  "name": "@coldcanuk/ceci",
  "version": "1.0.0",
  "description": "Agent skill for Claude Code, Codex, Grok, Cline, Goose, and Hermes that turns a goal into a job graph, runs ready jobs in dependency order, stops at human gates before contact, posting, payment, or pricing, places GPU jobs, and gates code changes with /rdap-q. Invoke with /ceci.",
  "type": "commonjs",
  "main": "ceci-skill/SKILL.md",
  "bin": {
    "ceci": "bin/ceci.js"
  },
  "author": {
    "name": "coldcanuk",
    "email": "chuck@actvite.com",
    "url": "https://actvite.com"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/actviteai/ceci#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actviteai/ceci.git"
  },
  "bugs": {
    "url": "https://github.com/actviteai/ceci/issues"
  },
  "keywords": [
    "ceci",
    "agent-skill",
    "job-graph",
    "task-graph",
    "dag",
    "human-in-the-loop",
    "approval-gates",
    "gpu-scheduling",
    "cuda",
    "agent-orchestration",
    "rdap-q",
    "claude-code",
    "codex",
    "grok",
    "cline",
    "goose",
    "hermes",
    "claude-code-plugin",
    "claude-code-skill",
    "codex-plugin",
    "grok-plugin",
    "hermes-agent",
    "ai-agent",
    "coding-agent",
    "llm-agents",
    "agent-workflow",
    "job-scheduler",
    "quality-gates",
    "cli"
  ],
  "scripts": {
    "start": "node bin/ceci.js",
    "test": "node scripts/sync-integrations.js --check && node --test --test-concurrency=1 ceci-skill/tool/ceci.test.js scripts/*.test.js",
    "sync": "node scripts/sync-integrations.js",
    "install:all": "node bin/ceci.js install --all",
    "install:claude": "node bin/ceci.js install --claude",
    "install:codex": "node bin/ceci.js install --codex",
    "install:grok": "node bin/ceci.js install --grok",
    "install:cline": "node bin/ceci.js install --cline",
    "install:goose": "node bin/ceci.js install --goose",
    "install:hermes": "node bin/ceci.js install --hermes"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "ceci-skill",
    "lib",
    "scripts/install.js",
    "scripts/sync-integrations.js",
    "integrations",
    "plugins",
    "AGENTS.md",
    "CLAUDE.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    ".claude-plugin",
    "!**/*.test.js"
  ]
}
