# ==============================================================================
# ceci Repository .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# ceci & RDAP-Q runtime state
# ------------------------------------------------------------------------------
# Work directories (brief.md, state.md, log.md) and gate state are per-run.
.ceci/
.rdapq/
*.rdapq.tmp
*.rdapq.bak
# Pack bookkeeping written by scripts/materialize-skill-links.js
.ceci-pack-state.json

# ------------------------------------------------------------------------------
# Git worktrees (AGENTS.md: every task runs in .worktrees/<task>)
# ------------------------------------------------------------------------------
.worktrees/
git-worktrees/

# ------------------------------------------------------------------------------
# Secrets & credentials (never commit)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
auth.json
token.txt
secrets.json

# ------------------------------------------------------------------------------
# AI agent & harness artifacts
# ------------------------------------------------------------------------------
# Agent harness folders are local by default: settings, sessions, caches,
# and other skills never get committed. Only the files this repository
# ships are un-ignored.
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/ceci.md
!.claude/skills/
.claude/skills/*
!.claude/skills/ceci
.grok/*
!.grok/rules.md
!.grok/skills/
.grok/skills/*
!.grok/skills/ceci
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/ceci
.agent/
.codex/
.copilot/
*.claude.json

# Hermes
.hermes/

# Cline, Goose, Cursor, Windsurf
.cline/history/
.cline/sessions/
.goose/
.cursor/
.windsurf/

# ------------------------------------------------------------------------------
# Operating system artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.fuse_hidden*
.nfs*

# ------------------------------------------------------------------------------
# Editors & IDEs
# ------------------------------------------------------------------------------
.idea/
*.iml
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Node / npm
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tgz
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# Python (GPU / scoring helpers)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ------------------------------------------------------------------------------
# Build output & temporary files
# ------------------------------------------------------------------------------
dist/
build/
out/
.cache/
tmp/
temp/
*.tmp
*.bak
*.orig
*.log
